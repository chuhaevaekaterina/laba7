matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

n = len(matrix)
total_sum = 0
for k in range(1, n + 1):
    current_max = float('-inf')
for i in range(k):
    for j in range(k):
        if matrix[i][j] > current_max:
            current_max = matrix[i][j]
 print(f"Для квадрата {k}x{k} максимум = {current_max}")
    total_sum += current_max
print("Итоговая сумма:", total_sum)
